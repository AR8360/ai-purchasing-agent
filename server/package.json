{
  "name": "@purchasing/server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "seed": "tsx src/seed/cli.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p .",
    "llm:ping": "tsx src/scripts/llmPing.ts",
    "db:ping": "tsx src/scripts/dbPing.ts",
    "show": "tsx src/scripts/showDecision.ts",
    "eval": "tsx src/eval/cli.ts --mode replay",
    "eval:record": "tsx src/eval/cli.ts --mode record",
    "eval:live": "tsx src/eval/cli.ts --mode live"
  },
  "dependencies": {
    "@google/genai": "^2.32.0",
    "@purchasing/shared": "*",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "mongoose": "^8.8.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.9.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^2.1.4"
  }
}
