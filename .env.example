# --- LLM (Google Gemini free tier) ---
LLM_PROVIDER=gemini
# Create a key at https://aistudio.google.com (API keys). Never commit the real value.
GEMINI_API_KEY=
# A current Flash / Flash-Lite model name from Google AI Studio. The eval fixtures were
# recorded with gemini-3.5-flash-lite (free tier of larger models can be ~20 requests/day).
MODEL=gemini-3.5-flash-lite
# Minimum gap between model calls (free-tier rate limits). Raise it if you see 429s.
LLM_MIN_INTERVAL_MS=1500
# LOW | HIGH | (empty = model default). Falls back automatically if the model rejects it.
LLM_THINKING_LEVEL=LOW
# off | record | replay. "record" reuses eval/fixtures when a response is cached and
# records new ones; useful for a fast, quota-free demo.
LLM_CACHE=off

# --- MongoDB (Atlas or local) ---
MONGO_URI=mongodb://localhost:27017/purchasing

# --- Server ---
PORT=4000
# Simulated "now" for the demo world. Seeds are relative to this instant.
SIM_NOW=2026-11-01T00:00:00.000Z
